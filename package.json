{
  "name": "rain-harvest-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Three.js simulation of urban rainwater harvesting: rooftop catchment, downspouts, cisterns, district storage, sewer surcharge and street flooding.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
